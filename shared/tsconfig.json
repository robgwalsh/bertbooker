{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // fetch/Response/RequestInit — standard web APIs available in Node 18+ and
    // Cloudflare Workers; used by the seats.aero provider. workers-types adds
    // the D1Database binding that `ingest/apply.ts` references at module scope
    // (skipLibCheck keeps the DOM+workers-types overlap quiet).
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
