{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    // Node, not Workers: this package exists precisely because it does NOT run
    // on Cloudflare. DOM is here for fetch/Response/RequestInit, which core's
    // provider code is typed against.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
