{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  // No `paths` block: there is no package to alias, and a relative specifier
  // resolves the same way in tsc, wrangler's esbuild and vitest.
  "include": ["src/**/*.ts", "src/**/*.json"]
}
