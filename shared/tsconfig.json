{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // fetch/Response/RequestInit — standard web APIs available in Node 18+ and
    // Cloudflare Workers; used by the seats.aero provider. workers-types adds
    // the D1Database binding that `ingest/apply.ts` references at module scope
    // (skipLibCheck keeps the DOM+workers-types overlap quiet).
    //
    // Nothing is EMITTED from here. This directory used to be a package that
    // published .d.ts into `dist/`, for a plain-Node consumer that no longer
    // exists; the Worker imports the .ts sources directly by relative path and
    // wrangler's esbuild compiles them with everything else.
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
