node_modules/
dist/
.wrangler/
.wrangler-local/
# The Worker's secrets, and the only environment file left. The tracked template
# beside it needs no negation — this pattern is an exact name, not a prefix — but
# `git check-ignore` is the only way to be sure of that, so check before adding
# another template.
.dev.vars
*.local
.DS_Store
# There is no longer a repo-root `.env`; these stay so that reintroducing one by
# accident cannot commit it.
.env
.env.*
coverage/
*.log

# The UI harness (docs/UI-TESTING.md). `.auth/state.json` is a LIVE session
# cookie for the local API; `.artifacts/` is screenshots, traces and reports.
e2e/.auth/
e2e/.artifacts/
# Playwright's own defaults, in case a run ever misses playwright.config.ts.
playwright-report/
test-results/

# One-off D1 backups (see the export command in CLAUDE.md).
backup*.sql
restore-bookmark.txt
