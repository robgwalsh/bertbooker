# Copy to `.env` in this same directory (the repo root) and fill in. That file
# is gitignored.
#
#   cp .env.example .env
#
# This is the GATHERER's environment — read by packages/local-sources/src/env.ts
# into its own process.env, and by nothing else. **workerd never sees it.**
# Putting APP_PASSWORD here sets it for nobody, and the symptom is a password
# that is definitely correct being rejected as `bad_password`; the Worker's copy
# is workers/api/.dev.vars (see .dev.vars.example there).
#
# The two files overlap on exactly one key, INGEST_TOKEN, because both processes
# genuinely need it.
#
# An already-set shell variable always wins over a line here, so a one-off
# `BERTBOOKER_API_URL=... npm run gather` still does what it says.
#
# You need none of this unless you run `npm run gather`.


# Where `npm run gather` POSTs what it finds. Defaults to the local dev API, so
# leave it alone while developing.
#
# Pointing this at a DEPLOYED instance: use the workers.dev host, not a custom
# domain. A zone with bot protection challenges non-browser traffic before it
# reaches the Worker, so ingest POSTs from Node get a 403 challenge page rather
# than an answer — after the gathering has already been paid for.
BERTBOOKER_API_URL=http://127.0.0.1:8787

# Shared secret presented to /api/ingest/*. Must be byte-identical to the
# INGEST_TOKEN in workers/api/.dev.vars (local) or to the deployed secret
# (`wrangler secret put INGEST_TOKEN`), or ingest is refused as
# `bad_ingest_token`.
#
# If the Worker's copy is unset there is no check at all, so this can stay empty
# for purely local work.
INGEST_TOKEN=

# Optional, and only for the headless UI suite (`npm run test:ui`): the password
# it types on the way in. Unset, the harness reads APP_PASSWORD straight out of
# workers/api/.dev.vars, which is usually what you want. See docs/UI-TESTING.md.
# BERTBOOKER_APP_PASSWORD=
